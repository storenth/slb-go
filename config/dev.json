{
  "services": [
    {
      "name": "web",
      "listeners": [
        {"address": "127.0.0.1", "protocol": "tcp", "port": 8443}
      ],
      "backends": [
        {"host": "127.0.0.1", "port": 9443},
        {"host": "127.0.0.1", "port": 9444}
      ],
      "affinity": "none",
      "dial": {"timeout": "3s", "max_attempts": 3, "budget": "5s"},
      "ejection": {"consecutive_failures": 3, "base_time": "30s", "max_time": "5m"}
    }
  ],
  "timeouts": {"idle": "5m"}
}
